# Copy this file to ".env" for local work, and add the same names in Vercel > Settings > Environment Variables.
# NEVER put real values in this example file. NEVER commit ".env".

# PostgreSQL connection string from Neon (or any Postgres). Looks like postgresql://user:pass@host/db?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# A long random text (32+ characters) used to sign login cookies. Make one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=replace-with-a-long-random-value

# Where buyers/owners send UPI payments (shown on the Pay screen)
UPI_ID=yourname@bank
UPI_PAYEE_NAME=Your Business Name

# Only used once, on your own computer, by "npm run create-admin". Do NOT add these to Vercel.
ADMIN_EMAIL=
ADMIN_PASSWORD=
